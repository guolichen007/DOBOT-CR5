<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- JointCaptureManager: cross-camera sync capture.
       Usage:
         roslaunch cr5_spray_perception calibration_pipeline.launch
         roslaunch cr5_spray_perception calibration_pipeline.launch \
           run_id:=sim_calib_001 output_dir:=/tmp/test_capture
  -->
  <arg name="output_dir" default="$(env HOME)/cr5_data/calibration/raw"/>
  <arg name="run_id"     default=""/>

  <node name="joint_capture_manager" pkg="cr5_spray_perception"
    type="joint_capture_manager.py" output="screen">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="run_id"     value="$(arg run_id)"/>
    <rosparam param="camera_names">
      - cam_front_left
      - cam_front_right
      - cam_rear
    </rosparam>
    <param name="timeout_s" value="15.0"/>
    <param name="sync_slop_s" value="0.05"/>
    <param name="cross_sync_slop_s" value="0.033"/>
    <param name="max_inter_camera_skew_s" value="0.005"/>
    <param name="max_color_depth_skew_s" value="0.030"/>
    <param name="max_camera_info_skew_s" value="0.030"/>
    <param name="require_extrinsics" value="false"/>
  </node>
</launch>
